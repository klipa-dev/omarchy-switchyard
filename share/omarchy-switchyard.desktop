[Desktop Entry]
Type=Application
Name=Switchyard
Comment=Opens the sites you choose as web apps, and everything else in your usual browser
Exec=__HANDLER__ %u
Icon=web-browser
Terminal=false
NoDisplay=true
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
