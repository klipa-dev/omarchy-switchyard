#!/bin/bash
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

fail() {
  echo "omarchy-switchyard: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: omarchy-switchyard <command>

Commands:
  activate [--fallback <desktop-id>]  register Switchyard as the default browser
  deactivate                          restore the browser that was default before activate
  status [--json]                     show whether Switchyard is active, and recent log lines
  open [--dry-run] [flags] <url>      route and launch <url> the way a clicked link would
  rules list [--json]                 show the configured rules
  rules add <host> <target>           add a rule, or replace the one for <host>
  rules remove <host>                 remove the rule for <host>
  fallback [<desktop-id>]             show, or set, the fallback browser
  browsers [--json]                   list installed browsers
  --help, -h                          show this help
EOF
}

script_dir="$(dirname "$(readlink -f "$0")")"
repo_root="$(dirname "$script_dir")"
# shellcheck source=../lib/desktop.sh
source "$repo_root/lib/desktop.sh"
handler="$script_dir/omarchy-switchyard-open"
template="$repo_root/share/omarchy-switchyard.desktop"
desktop_id="omarchy-switchyard.desktop"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-switchyard"
apps_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-switchyard"

xdg_settings() {
  env -u BROWSER xdg-settings "$@"
}

# The fallback-browser note on activate, and the Chromium-web-apps warning,
# use the same Chromium-family desktop-id list omarchy-launch-webapp does
# (lib/launch.sh's switchyard_webapp_browser mirrors it too).
is_chromium_family() {
  case "$1" in
    chromium.desktop | google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) return 0 ;;
    *) return 1 ;;
  esac
}

# Same search omarchy-launch-browser uses to resolve a desktop id's Exec;
# here we only need to know the entry exists, not what it runs.
desktop_entry_exists() {
  local id="$1" dir
  while IFS= read -r dir; do
    [[ -f "$dir/$id" ]] && return 0
  done < <(switchyard_applications_dirs)
  return 1
}

# valid_desktop_id <id> — a desktop id that ends in ".desktop" and resolves
# to an installed entry.
valid_desktop_id() {
  local id="$1"
  [[ "$id" == *.desktop ]] || return 1
  desktop_entry_exists "$id"
}

# valid_host <host> — a bare host or hostname glob: lowercase letters,
# digits, "." and "-", optionally prefixed with "*.", with no empty label
# (no leading, trailing or doubled ".").
valid_host() {
  local host="$1" rest
  [[ "$host" =~ ^(\*\.)?[a-z0-9.-]+$ ]] || return 1
  rest="$host"
  [[ "$rest" == \*.* ]] && rest="${rest#\*.}"
  [[ "$rest" != *".."* && "$rest" != .* && "$rest" != *. ]]
}

# valid_target <target> — "webapp", or a desktop id that resolves to an
# installed entry.
valid_target() {
  local target="$1"
  [[ "$target" == "webapp" ]] && return 0
  valid_desktop_id "$target"
}

rules_path="$config_dir/rules.json"
fallback_path="$config_dir/fallback"

# rules_doc — prints the parsed rules.json as a single compact JSON value,
# or the empty default ({"version": 1, "rules": []}) when the file is
# missing; fails without printing anything when the file exists but its
# .rules is not an array.
rules_doc() {
  if [[ ! -f "$rules_path" ]]; then
    echo '{"version": 1, "rules": []}'
    return 0
  fi
  jq -e '(.rules // null) | type == "array"' "$rules_path" >/dev/null 2>&1 \
    || fail "rules.json is invalid; fix it by hand: $rules_path"
  jq -c '.' "$rules_path"
}

# write_rules_doc <json> — atomically replaces rules.json with <json>.
write_rules_doc() {
  local doc="$1" tmp
  mkdir -p "$config_dir"
  tmp=$(mktemp "$config_dir/rules.json.XXXXXX")
  printf '%s\n' "$doc" >"$tmp"
  mv "$tmp" "$rules_path"
}

cmd_activate() {
  local fallback_arg=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fallback)
        [[ $# -ge 2 ]] || fail "--fallback requires a desktop id"
        fallback_arg="$2"
        shift 2
        ;;
      *)
        fail "activate: unknown option: $1"
        ;;
    esac
  done

  [[ "$handler" == *[[:space:]]* ]] && fail "handler path contains whitespace: $handler"
  [[ -x "$handler" ]] || fail "handler is not executable: $handler"

  mkdir -p "$apps_dir"
  sed "s#__HANDLER__#$handler#" "$template" >"$apps_dir/$desktop_id"

  local current
  current=$(xdg_settings get default-web-browser || true)

  if [[ -n "$fallback_arg" ]]; then
    desktop_entry_exists "$fallback_arg" || fail "no desktop entry found for $fallback_arg"
    mkdir -p "$config_dir"
    printf '%s\n' "$fallback_arg" >"$config_dir/fallback"
  elif [[ -n "$current" && "$current" != "$desktop_id" ]]; then
    mkdir -p "$config_dir"
    printf '%s\n' "$current" >"$config_dir/fallback"
  elif [[ -f "$config_dir/fallback" ]]; then
    : # already recorded; keep it
  else
    fail "no fallback browser known; run: omarchy-switchyard activate --fallback <desktop-id>"
  fi

  xdg_settings set default-web-browser "$desktop_id" || fail "failed to set default browser"

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$apps_dir" || true
  fi

  local fallback
  fallback=$(cat "$config_dir/fallback")
  echo "Switchyard is the default browser; unmatched links open in $fallback"

  if is_chromium_family "$fallback" && [[ "$fallback" != "chromium.desktop" ]]; then
    echo "Note: while Switchyard is active, Omarchy web apps open in Chromium (not $fallback); see README -> Limitations"
  fi
}

cmd_deactivate() {
  local current
  current=$(xdg_settings get default-web-browser || true)

  if [[ "$current" == "$desktop_id" ]]; then
    if [[ -f "$config_dir/fallback" ]]; then
      local fallback
      fallback=$(cat "$config_dir/fallback")
      xdg_settings set default-web-browser "$fallback" || fail "failed to restore default browser"
      echo "Default browser restored to $fallback"
    else
      echo "Switchyard is active but no fallback browser is recorded; default browser left unchanged. Run: omarchy-switchyard activate --fallback <desktop-id>"
    fi
  else
    echo "Switchyard is not active (default browser is $current)"
  fi
}

cmd_rules() {
  local sub="${1:-}"
  [[ $# -ge 1 ]] || fail "rules: usage: rules list|add|remove ..."
  shift

  case "$sub" in
    list)
      local json=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json) json=1; shift ;;
          *) fail "rules list: unknown option: $1" ;;
        esac
      done
      local doc
      doc=$(rules_doc)
      if ((json)); then
        jq -c '.rules' <<<"$doc"
      else
        jq -r '.rules[] | "\(.host)\t\(.target)"' <<<"$doc"
      fi
      ;;
    add)
      [[ $# -eq 2 ]] || fail "rules add: usage: rules add <host> <target>"
      local host="${1,,}" target="$2"
      valid_host "$host" || fail "invalid host: $host"
      if [[ "$target" != "webapp" ]]; then
        [[ "$target" == *.desktop ]] || fail "target must be webapp or a .desktop id: $target"
        desktop_entry_exists "$target" || fail "no desktop entry for $target"
      fi

      local doc updated
      doc=$(rules_doc)
      updated=$(jq -c --arg host "$host" --arg target "$target" '
        .rules |= (
          if any(.[]; .host == $host)
          then map(if .host == $host then {host: $host, target: $target} else . end)
          else . + [{host: $host, target: $target}]
          end
        )
      ' <<<"$doc")
      write_rules_doc "$updated"
      ;;
    remove)
      [[ $# -eq 1 ]] || fail "rules remove: usage: rules remove <host>"
      local host="${1,,}"
      local doc
      doc=$(rules_doc)
      jq -e --arg host "$host" 'any(.rules[]; .host == $host)' <<<"$doc" >/dev/null \
        || fail "no rule for host: $host"
      local updated
      updated=$(jq -c --arg host "$host" '.rules |= map(select(.host != $host))' <<<"$doc")
      write_rules_doc "$updated"
      ;;
    *)
      fail "rules: unknown subcommand: $sub"
      ;;
  esac
}

cmd_fallback() {
  [[ $# -le 1 ]] || fail "fallback: usage: fallback [<desktop-id>]"

  if [[ $# -eq 0 ]]; then
    if [[ -f "$fallback_path" ]]; then
      cat "$fallback_path"
    else
      echo "(none)"
    fi
    return 0
  fi

  local id="$1"
  valid_desktop_id "$id" || fail "no desktop entry for $id"
  mkdir -p "$config_dir"
  local tmp
  tmp=$(mktemp "$config_dir/fallback.XXXXXX")
  printf '%s\n' "$id" >"$tmp"
  mv "$tmp" "$fallback_path"
}

cmd_browsers() {
  local json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      *) fail "browsers: unknown option: $1" ;;
    esac
  done

  local -A seen=()
  local -a lines=()
  local dir f id name mimetype categories nodisplay

  while IFS= read -r dir; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.desktop; do
      [[ -f "$f" ]] || continue
      id="$(basename "$f")"
      [[ "$id" == "$desktop_id" ]] && continue
      [[ -n "${seen[$id]:-}" ]] && continue
      seen[$id]=1

      nodisplay=$(sed -n 's/^NoDisplay=//p' "$f" | head -1)
      [[ "$nodisplay" == "true" ]] && continue

      mimetype=$(sed -n 's/^MimeType=//p' "$f" | head -1)
      categories=$(sed -n 's/^Categories=//p' "$f" | head -1)
      [[ "$mimetype" == *"x-scheme-handler/https"* || "$categories" == *"WebBrowser"* ]] || continue

      name=$(sed -n 's/^Name=//p' "$f" | head -1)
      [[ -n "$name" ]] || name="$id"
      lines+=("$(printf '%s\t%s' "$id" "$name")")
    done
  done < <(switchyard_applications_dirs)

  local sorted=""
  if ((${#lines[@]})); then
    sorted=$(printf '%s\n' "${lines[@]}" | sort)
  fi

  if ((json)); then
    jq -n --arg raw "$sorted" '
      if $raw == "" then []
      else
        $raw | split("\n") | map(select(length > 0) | split("\t") | {id: .[0], name: .[1]})
      end
    '
  elif [[ -n "$sorted" ]]; then
    printf '%s\n' "$sorted"
  fi
}

cmd_status() {
  local json=0
  case "${1:-}" in
    --json) json=1; shift ;;
    "") ;;
    *) fail "status: unknown option: $1" ;;
  esac

  local current active fallback_recorded fallback_display
  local rules_state rules_count log_path n

  current=$(xdg_settings get default-web-browser || true)
  if [[ "$current" == "$desktop_id" ]]; then
    active="yes"
  else
    active="no"
  fi

  if [[ -f "$fallback_path" ]]; then
    fallback_recorded=$(cat "$fallback_path")
    fallback_display="$fallback_recorded"
  else
    fallback_recorded=""
    fallback_display="(none)"
  fi

  rules_count=""
  if [[ ! -f "$rules_path" ]]; then
    rules_state="missing"
  elif ! jq -e . "$rules_path" >/dev/null 2>&1; then
    rules_state="invalid"
  else
    n=$(jq -e '.rules | if type == "array" then length else null end' "$rules_path" 2>/dev/null) || n=""
    if [[ -z "$n" || "$n" == "null" ]]; then
      rules_state="invalid"
    else
      rules_state="ok"
      rules_count="$n"
    fi
  fi

  log_path="$state_dir/log"
  local recent=""
  if [[ -f "$log_path" ]]; then
    recent=$(tail -n 5 "$log_path")
  fi

  if ((json)); then
    jq -n \
      --arg active "$active" \
      --arg default_browser "$current" \
      --arg fallback "$fallback_recorded" \
      --arg rules_path "$rules_path" \
      --arg rules_count "$rules_count" \
      --arg rules_state "$rules_state" \
      --arg handler "$handler" \
      --arg recent "$recent" \
      '{
        active: ($active == "yes"),
        default_browser: $default_browser,
        fallback: (if $fallback == "" then null else $fallback end),
        rules_path: $rules_path,
        rules_count: (if $rules_count == "" then null else ($rules_count | tonumber) end),
        rules_state: $rules_state,
        handler: $handler,
        recent: (if $recent == "" then [] else ($recent | split("\n") | map(select(length > 0))) end)
      }'
    return 0
  fi

  echo "active: $active"
  echo "default browser: $current"
  echo "fallback: $fallback_display"

  local rules_status_text
  case "$rules_state" in
    missing) rules_status_text="missing" ;;
    invalid) rules_status_text="invalid JSON" ;;
    ok) rules_status_text="$rules_count rules" ;;
  esac
  echo "rules: $rules_path ($rules_status_text)"

  echo "handler: $handler"

  if [[ -n "$recent" ]]; then
    echo "recent:"
    printf '%s\n' "$recent"
  fi

  return 0
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
  activate)
    shift
    cmd_activate "$@"
    ;;
  deactivate)
    shift
    cmd_deactivate "$@"
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  open)
    shift
    exec "$handler" "$@"
    ;;
  rules)
    shift
    cmd_rules "$@"
    ;;
  fallback)
    shift
    cmd_fallback "$@"
    ;;
  browsers)
    shift
    cmd_browsers "$@"
    ;;
  *)
    echo "omarchy-switchyard: unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
