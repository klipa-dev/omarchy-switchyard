#!/bin/bash
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: omarchy-switchyard-open [--dry-run] [browser-flags...] [url]

The handler the omarchy-switchyard.desktop entry runs with %u. Routes <url>
to a browser by the rules in
${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-switchyard/rules.json and launches
it; not normally run by hand.

  --dry-run                 print the command that would run, launch nothing
  --private, --incognito,
  --private-window, --inprivate
                             open a private/incognito window
  -h, --help                show this help
EOF
}

script_dir=$(dirname "$(readlink -f "$0")")
# shellcheck source=../lib/desktop.sh
source "$script_dir/../lib/desktop.sh"
# shellcheck source=../lib/router.sh
source "$script_dir/../lib/router.sh"
# shellcheck source=../lib/launch.sh
source "$script_dir/../lib/launch.sh"

# switchyard_run_launch <target> <url> <fallback-file> [browser-flags...] —
# runs switchyard_launch into a tmp file, capturing its stderr into
# launch_stderr (printed when non-empty) and its exit status into
# launch_status. Both are left as plain (non-local) variables for the
# caller to inspect.
switchyard_run_launch() {
  local err
  err=$(mktemp)
  launch_status=0
  switchyard_launch "$@" 2>"$err" || launch_status=$?
  launch_stderr=$(cat "$err")
  rm -f "$err"
  # An `if`, not `[[ ]] &&`: as the function's last statement, a false
  # `&&` short-circuit would make the function itself return non-zero
  # whenever there's no stderr to print, tripping set -e in the caller.
  if [[ -n $launch_stderr ]]; then
    printf '%s\n' "$launch_stderr" >&2
  fi
}

url=""
flags=()
for arg in "$@"; do
  case $arg in
  -h | --help)
    usage
    exit 0
    ;;
  --dry-run)
    export SWITCHYARD_DRY_RUN=1
    ;;
  --private | --incognito | --private-window | --inprivate)
    flags+=("--private")
    ;;
  -*)
    flags+=("$arg")
    ;;
  *)
    [[ -z $url ]] && url=$arg
    ;;
  esac
done

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-switchyard
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-switchyard
rules_file="$config_dir/rules.json"
fallback_file="$config_dir/fallback"

route_err=$(mktemp)
route=$(switchyard_route "$url" "$rules_file" "$fallback_file" 2>"$route_err") || {
  cat "$route_err" >&2
  rm -f "$route_err"
  exit 1
}
route_stderr=$(cat "$route_err")
rm -f "$route_err"
[[ -n $route_stderr ]] && printf '%s\n' "$route_stderr" >&2

target=${route%%$'\t'*}
reason=${route#*$'\t'}

if [[ $route_stderr == *"rules.json is invalid"* ]] && command -v omarchy-notification-send >/dev/null 2>&1; then
  omarchy-notification-send "Switchyard: rules.json is invalid, opening in $target" || true
fi

switchyard_run_launch "$target" "$url" "$fallback_file" "${flags[@]}"

# $SWITCHYARD_MISSING_TARGET means the resolved desktop id has no desktop
# entry, or is Switchyard's own (refused rather than launched; see
# lib/launch.sh). Retry with the fallback browser as a normal window, unless
# the target already is the fallback (then there is truly no browser to
# fall back to).
if [[ $launch_status -eq $SWITCHYARD_MISSING_TARGET ]]; then
  fallback_desktop_id=$(_switchyard_fallback "$fallback_file")
  if [[ $target != "$fallback_desktop_id" ]]; then
    if [[ $launch_stderr == *"refusing to launch Switchyard itself"* ]]; then
      # Already explained on stderr by lib/launch.sh; no further notice.
      reason="fallback:self"
    else
      missing_id=${launch_stderr#switchyard: no desktop entry for }
      notice="Switchyard: $missing_id is not installed, opening in $fallback_desktop_id"
      command -v omarchy-notification-send >/dev/null 2>&1 && omarchy-notification-send "$notice" || true
      printf '%s\n' "$notice" >&2
      reason="fallback:missing-target"
    fi

    target=$fallback_desktop_id

    switchyard_run_launch "$target" "$url" "$fallback_file" "${flags[@]}"
  fi
fi

# Skip the log write when the final attempt still returned
# $SWITCHYARD_MISSING_TARGET: nothing was actually launched (the
# double-failure case where the fallback browser itself has no desktop
# entry either), so a "fallback:missing-target" line would misrepresent
# that browser as having been opened. The exit status below still reports
# the failure.
if [[ ${SWITCHYARD_DRY_RUN:-0} != 1 ]] && [[ $launch_status -ne $SWITCHYARD_MISSING_TARGET ]]; then
  mkdir -p "$state_dir"
  log_file="$state_dir/log"
  timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  # The host only, never the full link: a query string can carry a
  # magic-login token. "-" when the URL has none (a bare `open` with no
  # URL) or isn't http(s) at all.
  log_host=$(_switchyard_host "$url") || log_host="-"
  printf '%s\t%s\t%s\t%s\n' "$timestamp" "$log_host" "$target" "$reason" >>"$log_file"
  tmp_log=$(mktemp "$state_dir/log.XXXXXX")
  tail -n 200 "$log_file" >"$tmp_log"
  mv "$tmp_log" "$log_file"
fi

exit "$launch_status"
